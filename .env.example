# FACEIT Data API (https://developers.faceit.com). Sem a chave, o app usa o
# nível FACEIT que a Leetify expõe no perfil.
FACEIT_API_KEY=

# Opcional. O app resolve vanity URLs sem chave pelo XML da Steam.
STEAM_API_KEY=

# Opcional. A API pública da Leetify funciona sem chave, com limite menor.
LEETIFY_API_KEY=

# Usado em links absolutos e no compartilhamento.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
